FUNCTION_BLOCK fuzzyIDS

VAR_INPUT
    MSI : REAL;
    PVAR : REAL;
    SIZE : REAL;
    VOL : REAL;
    FLOWS : REAL;
END_VAR

VAR_OUTPUT
    FIDS_SCORE : REAL;
END_VAR

// --- FUZZIFICATION ---

FUZZIFY MSI
    TERM NORM := (-6, 0) (0, 1) (6, 0);
    TERM HIGH := (0, 0) (6, 1) (10, 1) (10, 1);
END_FUZZIFY

FUZZIFY PVAR
    TERM NORM := (-6, 0) (0, 1) (6, 0);
    TERM HIGH := (0, 0) (6, 1) (10, 1) (10, 1);
END_FUZZIFY

FUZZIFY SIZE
    TERM NORM := (-6, 0) (0, 1) (6, 0);
    TERM HIGH := (0, 0) (6, 1) (10, 1) (10, 1);
END_FUZZIFY

FUZZIFY VOL
    TERM NORM := (-6, 0) (0, 1) (6, 0);
    TERM HIGH := (0, 0) (6, 1) (10, 1) (10, 1);
END_FUZZIFY

FUZZIFY FLOWS
    TERM NORM := (-6, 0) (0, 1) (6, 0);
    TERM HIGH := (0, 0) (6, 1) (10, 1) (10, 1);
END_FUZZIFY

// --- DEFUZZIFICATION ---

DEFUZZIFY FIDS_SCORE
    TERM SAFE := (-100, 0) (0, 1) (100, 0);
    TERM ATTACK := (0, 0) (100, 1) (200, 0);

    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY

// --- INFERENCE RULES (32 combinations: MSI, PVAR, SIZE, VOL, FLOWS) ---
// Legenda wartości termów: 1 = NORM, 2 = HIGH
// Konsekwencja: 1 = SAFE, 2 = ATTACK

RULEBLOCK No1
    AND : PROD;
    OR : MAX;
    ACT : PROD;
    ACCU : MAX;

    RULE r1  : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS SAFE;
    RULE r2  : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r3  : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r4  : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r5  : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r6  : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r7  : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r8  : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r9  : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r10 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r11 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r12 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r13 : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r14 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r15 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r16 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS NORM THEN FIDS_SCORE IS ATTACK;
    RULE r17 : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r18 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r19 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r20 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r21 : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r22 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r23 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r24 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS NORM AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r25 : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r26 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r27 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r28 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS NORM AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r29 : IF MSI IS NORM AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r30 : IF MSI IS HIGH AND PVAR IS NORM AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r31 : IF MSI IS NORM AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;
    RULE r32 : IF MSI IS HIGH AND PVAR IS HIGH AND SIZE IS HIGH AND VOL IS HIGH AND FLOWS IS HIGH THEN FIDS_SCORE IS ATTACK;

END_RULEBLOCK

END_FUNCTION_BLOCK